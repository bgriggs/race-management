<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TypeGen" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Channels\Channels.csproj" />
	</ItemGroup>

	<!-- Dev-time codegen: regenerates the UI's TypeScript DTOs (tgconfig.json -> ../../ui/...)
	     from these C# models. Skipped when the UI tree isn't present, e.g. container/publish
	     builds whose Docker context only copies services/ — otherwise typegen has nowhere to
	     write and fails the image build. Forward slashes so the path resolves on Linux too. -->
	<Target Name="GenerateTypeScriptModels" AfterTargets="Build"
			Condition="Exists('$(MSBuildProjectDirectory)/../../ui/shared-ui/src/models')">
		<Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
		<Exec Command="dotnet tool run dotnet-typegen generate" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>
