<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TypeGen" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Channels\Channels.csproj" />
	</ItemGroup>

	<!-- Dev-time codegen: regenerates the UI's TypeScript DTOs (tgconfig.json -> ../../ui/...)
	     from these C# models. Never run it in container/publish image builds: the Docker
	     context copies ui/ but typegen still fails there, and the generated TS is consumed
	     only by the Angular UI, not the C# compile. Skipped when SkipTypeScriptGen=true
	     (passed by the Dockerfiles) or inside a .NET container (DOTNET_RUNNING_IN_CONTAINER,
	     set by the SDK base image). Forward slashes so paths resolve on Linux too. -->
	<Target Name="GenerateTypeScriptModels" AfterTargets="Build"
			Condition="'$(SkipTypeScriptGen)' != 'true' and '$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">
		<Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
		<Exec Command="dotnet tool run dotnet-typegen generate" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>
