{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "raceManagementApi": {
        "ClusterId": "raceManagement",
        "Match": {
          "Path": "/v1.0/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "raceManagement": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5565/"
          }
        }
      }
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}"
      },
      "file": {
        "type": "File",
        "fileName": "${basedir}/logs/race-management-ui-${shortdate}.log",
        "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}${newline}${exception:format=tostring:maxInnerExceptionLevel=10}}",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 10
      }
    },
    "rules": [
      {
        "logger": "System.*",
        "finalMinLevel": "Warn"
      },
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Warn"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console,file"
      }
    ]
  }
}
