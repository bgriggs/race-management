{
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "broadcast": {
        "type": "LogBroadcast",
        "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}${newline}${exception:format=tostring:maxInnerExceptionLevel=10}}"
      },
      "file": {
        "type": "BufferingWrapper",
        "bufferSize": 100,
        "flushTimeout": 10000,
        "target": {
          "type": "File",
          "fileName": "racecar.log",
          "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}${newline}${exception:format=tostring:maxInnerExceptionLevel=10}}",
          "archiveAboveSize": 10485760,
          "maxArchiveFiles": 1,
          "archiveFileName": "racecar.{#}.log",
          "archiveNumbering": "Rolling"
        }
      },
      "console": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${pad:padding=5:inner=${level:uppercase=true}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}${newline}${exception:format=tostring:maxInnerExceptionLevel=10}}",
        "rowHighlightingRules": [
          {
            "condition": "level == LogLevel.Trace",
            "foregroundColor": "Gray"
          },
          {
            "condition": "level == LogLevel.Info",
            "foregroundColor": "Green"
          },
          {
            "condition": "level == LogLevel.Warning",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "Red",
            "backgroundColor": "White"
          }
        ]
      }
    },
    "rules": [
      {
        "logger": "System.*",
        "finalMinLevel": "Warn"
      },
      {
        "logger": "Microsoft.*",
        "finalMinLevel": "Warn"
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "console,file,broadcast"
      }
    ]
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Realm": "race-management",
    "AuthServerUrl": "https://auth.redmist.racing"
  },
  "Server": {
    "StatusHub": "https://api.redmist.racing/car-gateway/car-status"
  }
}
