{
  "name": "race-management-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "ng": "ng",
    "generate:version": "node scripts/generate-version.mjs",
    "prestart:cloud": "npm run generate:version",
    "start:cloud": "ng serve race-management-cloud",
    "prestart:local": "npm run generate:version",
    "start:local": "ng serve race-management-local",
    "prebuild:cloud": "npm run generate:version",
    "build:cloud": "ng build race-management-cloud",
    "prebuild:local": "npm run generate:version",
    "build:local": "ng build race-management-local",
    "build:all": "npm run build:cloud && npm run build:local",
    "test:cloud": "ng test race-management-cloud",
    "test:local": "ng test race-management-local",
    "test:shared-ui": "ng test shared-ui",
    "test:all": "ng test shared-ui && ng test race-management-cloud && ng test race-management-local"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "21.2.12",
    "@angular/cdk": "21.2.12",
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/forms": "21.2.12",
    "@angular/material": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@angular/router": "21.2.12",
    "@microsoft/signalr": "^10.0.0",
    "@microsoft/signalr-protocol-msgpack": "^10.0.0",
    "@msgpack/msgpack": "^3.1.2",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.12",
    "@angular/cli": "21.2.12",
    "@angular/compiler-cli": "21.2.12",
    "@angular/platform-browser-dynamic": "21.2.12",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
