{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "race-management-cloud": {
      "projectType": "application",
      "root": "race-management-cloud",
      "sourceRoot": "race-management-cloud/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "race-management-cloud/src/main.ts",
            "tsConfig": "race-management-cloud/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "race-management-cloud/public"
              }
            ],
            "styles": [
              "race-management-cloud/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "race-management-cloud:build:production"
            },
            "development": {
              "buildTarget": "race-management-cloud:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "race-management-local": {
      "projectType": "application",
      "root": "race-management-local",
      "sourceRoot": "race-management-local/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "race-management-local/src/main.ts",
            "tsConfig": "race-management-local/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "race-management-local/public"
              }
            ],
            "styles": [
              "race-management-local/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "race-management-local:build:production"
            },
            "development": {
              "buildTarget": "race-management-local:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}